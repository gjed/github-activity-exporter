{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Generated by OTel Weaver from registry/ (make generate). Queries use the UTF-8 names declared in annotations.prometheus; the backend must keep OTLP names as sent (translation strategy NoTranslation).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
{ "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1, "panels": [], "title": "Collection", "type": "row" }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Duration of a complete collection cycle in seconds.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.5, sum by (le, \"exporter.target\") (rate({\"github_exporter.scrape.duration_bucket\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval])))", "legendFormat": "{{exporter.target}} p50", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.9, sum by (le, \"exporter.target\") (rate({\"github_exporter.scrape.duration_bucket\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval])))", "legendFormat": "{{exporter.target}} p90", "range": true, "refId": "B" }
      ],
      "title": "Collection cycle duration",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of collection cycles that ran longer than the collection interval.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"exporter.target\") (rate({\"github_exporter.scrape.overruns\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval])) * 3600", "legendFormat": "{{exporter.target}}", "range": true, "refId": "A" }
      ],
      "title": "Collection cycle overruns per hour",
      "type": "timeseries"
    }
,{ "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "id": 4, "panels": [], "title": "GitHub API", "type": "row" }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of GitHub API errors encountered during collection.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 5,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"exporter.target\", \"github.api.endpoint\") (rate({\"github_exporter.api.errors\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval])) * 3600", "legendFormat": "{{exporter.target}} {{github.api.endpoint}}", "range": true, "refId": "A" }
      ],
      "title": "GitHub API errors per hour",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of GitHub API requests remaining in the current rate limit window.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "min by (\"exporter.target\", \"github.api.rate_limit.resource\") (last_over_time({\"github_exporter.api.rate_limit.remaining\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval]))", "legendFormat": "{{exporter.target}} {{github.api.rate_limit.resource}}", "range": true, "refId": "A" }
      ],
      "title": "Rate limit remaining by pool",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Unix time, in seconds, at which the current GitHub API rate limit window resets.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max by (\"exporter.target\", \"github.api.rate_limit.resource\") (last_over_time({\"github_exporter.api.rate_limit.reset\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval])) - time()", "legendFormat": "{{exporter.target}} {{github.api.rate_limit.resource}}", "range": true, "refId": "A" }
      ],
      "title": "Time until rate limit reset by pool",
      "type": "timeseries"
    }
,{ "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }, "id": 8, "panels": [], "title": "OTLP export", "type": "row" },{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of OTLP push failures.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 9,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"exporter.target\") (rate({\"github_exporter.otlp.errors\", job=~\"$job\"}[$__rate_interval])) * 3600", "legendFormat": "{{exporter.target}}", "range": true, "refId": "A" }
      ],
      "title": "OTLP push errors per hour",
      "type": "timeseries"
    },{ "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 }, "id": 10, "panels": [], "title": "Self-telemetry", "type": "row" }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Memory used by the Go runtime. Heap size target for the end of the GC cycle. Go runtime memory limit configured by the user, if a limit exists.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "id": 11,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"go.memory.type\") (last_over_time({\"go.memory.used\", job=~\"$job\"}[$__rate_interval]))", "legendFormat": "used {{go.memory.type}}", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum (last_over_time({\"go.memory.gc.goal\", job=~\"$job\"}[$__rate_interval]))", "legendFormat": "heap goal", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max (last_over_time({\"go.memory.limit\", job=~\"$job\"}[$__rate_interval]))", "legendFormat": "limit", "range": true, "refId": "C" }
      ],
      "title": "Go memory",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Memory allocated to the heap by the application.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "id": 12,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum (rate({\"go.memory.allocated\", job=~\"$job\"}[$__rate_interval]))", "legendFormat": "allocated", "range": true, "refId": "A" }
      ],
      "title": "Go heap allocation rate",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Count of live goroutines.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "id": 13,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum (last_over_time({\"go.goroutine.count\", job=~\"$job\"}[$__rate_interval]))", "legendFormat": "goroutines", "range": true, "refId": "A" }
      ],
      "title": "Goroutines",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Duration of HTTP client requests.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "id": 14,
      "interval": "$min_step",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.5, sum by (le, \"url.template\", \"http.response.status_code\") (rate({\"http.client.request.duration_bucket\", job=~\"$job\"}[$__rate_interval])))", "legendFormat": "{{url.template}} {{http.response.status_code}} p50", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.9, sum by (le, \"url.template\", \"http.response.status_code\") (rate({\"http.client.request.duration_bucket\", job=~\"$job\"}[$__rate_interval])))", "legendFormat": "{{url.template}} {{http.response.status_code}} p90", "range": true, "refId": "B" }
      ],
      "title": "GitHub API request latency",
      "type": "timeseries"
    }
],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["github","exporter","generated"],
  "templating": {
    "list": [
      { "current": {}, "includeAll": false, "label": "Data source", "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "regex": "", "type": "datasource" },

{
        "allValue": ".*",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values({\"github_exporter.scrape.duration_count\", job=~\"(.+/)?github-activity-exporter\"}, job)",
        "includeAll": true,
        "label": "Job",
        "multi": true,
        "name": "job",
        "options": [],
        "query": { "qryType": 5, "query": "label_values({\"github_exporter.scrape.duration_count\", job=~\"(.+/)?github-activity-exporter\"}, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
{
        "allValue": ".*",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values({\"github_exporter.scrape.duration_count\", job=~\"$job\"}, exporter.target)",
        "includeAll": true,
        "label": "exporter.target",
        "multi": true,
        "name": "target",
        "options": [],
        "query": { "qryType": 5, "query": "label_values({\"github_exporter.scrape.duration_count\", job=~\"$job\"}, exporter.target)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      { "current": { "text": "10m", "value": "10m" }, "description": "Min interval of every panel: at least 2x export.interval and 2x collection_interval.", "hide": 2, "label": "Min step", "name": "min_step", "options": [{ "selected": true, "text": "10m", "value": "10m" }], "query": "10m", "skipUrlSync": true, "type": "constant" }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "GitHub Activity Exporter",
  "uid": "github-activity-exporter-internals",
  "version": 1
}