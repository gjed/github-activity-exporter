{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Generated by OTel Weaver from registry/signals.yaml (make generate). Queries use the UTF-8 names declared in annotations.prometheus; the backend must keep OTLP names as sent (translation strategy NoTranslation).",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
{ "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1, "panels": [], "title": "Pull requests", "type": "row" }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of pull requests created.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum (rate({\"github.pr.created\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval])) * 3600", "legendFormat": "created", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum (rate({\"github.pr.merged\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval])) * 3600", "legendFormat": "merged", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum (rate({\"github.pr.closed\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval])) * 3600", "legendFormat": "closed", "range": true, "refId": "C" }
      ],
      "title": "PRs created, merged and closed per hour",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of pull requests created.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"github.org\", \"github.repo\") (rate({\"github.pr.created\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval])) * 3600", "legendFormat": "{{github.org}}/{{github.repo}} created", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"github.org\", \"github.repo\") (rate({\"github.pr.merged\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval])) * 3600", "legendFormat": "{{github.org}}/{{github.repo}} merged", "range": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"github.org\", \"github.repo\") (rate({\"github.pr.closed\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval])) * 3600", "legendFormat": "{{github.org}}/{{github.repo}} closed", "range": true, "refId": "C" }
      ],
      "title": "PRs created, merged and closed per hour by repo",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of open pull requests grouped by state and label.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"github.pr.state\") (last_over_time({\"github.pr.count\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\", \"github.pr.label\"=\"\"}[$__rate_interval]))", "legendFormat": "{{github.pr.state}}", "range": true, "refId": "A" }
      ],
      "title": "Open PRs by state",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of open pull requests grouped by review status.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 5,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"github.pr.review_status\") (last_over_time({\"github.pr.review_status\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval]))", "legendFormat": "{{github.pr.review_status}}", "range": true, "refId": "A" }
      ],
      "title": "Open PRs by review status",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Age of an open pull request in seconds (time since creation).",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 6,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max by (\"github.org\", \"github.repo\") (last_over_time({\"github.pr.age\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval]))", "legendFormat": "{{github.org}}/{{github.repo}}", "range": true, "refId": "A" }
      ],
      "title": "Oldest open PR age by repo",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Time from PR creation to close (merged or declined) in seconds.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 7,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.5, sum by (le) (rate({\"github.pr.close.duration_bucket\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval])))", "legendFormat": "p50", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.9, sum by (le) (rate({\"github.pr.close.duration_bucket\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval])))", "legendFormat": "p90", "range": true, "refId": "B" }
      ],
      "title": "PR close duration",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Total number of pull requests merged via automerge.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 8,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"github.org\", \"github.repo\") (rate({\"github.pr.automerged\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval])) * 3600", "legendFormat": "{{github.org}}/{{github.repo}}", "range": true, "refId": "A" }
      ],
      "title": "PRs automerged per hour",
      "type": "timeseries"
    }
,{ "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }, "id": 9, "panels": [], "title": "Issues", "type": "row" }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of GitHub issues grouped by state and label.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
      "id": 10,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"github.issue.state\") (last_over_time({\"github.issue.count\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\", \"github.issue.state\"!=\"\"}[$__rate_interval]))", "legendFormat": "{{github.issue.state}}", "range": true, "refId": "A" }
      ],
      "title": "Issues by state",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Age of the oldest open GitHub issue in seconds (time since creation).",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "id": 11,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max by (\"github.org\", \"github.repo\") (last_over_time({\"github.issue.age\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval]))", "legendFormat": "{{github.org}}/{{github.repo}}", "range": true, "refId": "A" }
      ],
      "title": "Oldest open issue age by repo",
      "type": "timeseries"
    }
,{ "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 }, "id": 12, "panels": [], "title": "GitHub API", "type": "row" }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of GitHub API requests remaining in the current rate limit window.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "id": 13,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "min by (\"exporter.target\", \"github.api.rate_limit.resource\") (last_over_time({\"github_exporter.api.rate_limit.remaining\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval]))", "legendFormat": "{{exporter.target}} {{github.api.rate_limit.resource}}", "range": true, "refId": "A" }
      ],
      "title": "Rate limit remaining by pool",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Unix time, in seconds, at which the current GitHub API rate limit window resets.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "id": 14,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max by (\"exporter.target\", \"github.api.rate_limit.resource\") (last_over_time({\"github_exporter.api.rate_limit.reset\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval])) - time()", "legendFormat": "{{exporter.target}} {{github.api.rate_limit.resource}}", "range": true, "refId": "A" }
      ],
      "title": "Time until rate limit reset by pool",
      "type": "timeseries"
    }
,{ "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 51 }, "id": 15, "panels": [], "title": "Exporter self-metrics", "type": "row" }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Duration of a complete collection cycle in seconds.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "id": 16,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.5, sum by (le, \"exporter.target\") (rate({\"github_exporter.scrape.duration_bucket\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval])))", "legendFormat": "{{exporter.target}} p50", "range": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.9, sum by (le, \"exporter.target\") (rate({\"github_exporter.scrape.duration_bucket\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval])))", "legendFormat": "{{exporter.target}} p90", "range": true, "refId": "B" }
      ],
      "title": "Collection cycle duration",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of GitHub API errors encountered during collection.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "id": 17,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"exporter.target\", \"github.api.endpoint\") (rate({\"github_exporter.api.errors\", job=~\"$job\", \"exporter.target\"=~\"$target\"}[$__rate_interval])) * 3600", "legendFormat": "{{exporter.target}} {{github.api.endpoint}}", "range": true, "refId": "A" }
      ],
      "title": "GitHub API errors per hour",
      "type": "timeseries"
    },{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of OTLP push failures.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 60 },
      "id": 18,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"exporter.target\") (rate({\"github_exporter.otlp.errors\", job=~\"$job\"}[$__rate_interval])) * 3600", "legendFormat": "{{exporter.target}}", "range": true, "refId": "A" }
      ],
      "title": "OTLP push errors per hour",
      "type": "timeseries"
    }
,{ "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 68 }, "id": 19, "panels": [], "title": "Dependency Dashboard", "type": "row" }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Number of pull requests in each section of the Renovate dependency dashboard.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 69 },
      "id": 20,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (\"github.org\", \"github.repo\", \"renovate.dashboard.section\") (last_over_time({\"renovate.dashboard.queue\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval]))", "legendFormat": "{{github.org}}/{{github.repo}} {{renovate.dashboard.section}}", "range": true, "refId": "A" }
      ],
      "title": "Renovate queue by section",
      "type": "timeseries"
    }
,{
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Set to 1 when the Renovate dependency dashboard cannot be parsed, 0 on success.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 69 },
      "id": 21,
      "interval": "10m",
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max by (\"github.org\", \"github.repo\") (last_over_time({\"renovate.dashboard.parse_error\", job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"=~\"$repo\"}[$__rate_interval]))", "legendFormat": "{{github.org}}/{{github.repo}}", "range": true, "refId": "A" }
      ],
      "title": "Dependency Dashboard parse errors",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["github", "renovate", "generated"],
  "templating": {
    "list": [
      { "current": {}, "includeAll": false, "label": "Data source", "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "regex": "", "type": "datasource" },
{
        "allValue": ".*",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values({\"github_exporter.scrape.duration_count\", job=~\"(.+/)?github-activity-exporter\"}, job)",
        "includeAll": true,
        "label": "Job",
        "multi": true,
        "name": "job",
        "options": [],
        "query": { "qryType": 5, "query": "label_values({\"github_exporter.scrape.duration_count\", job=~\"(.+/)?github-activity-exporter\"}, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
{
        "allValue": ".*",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values({\"github_exporter.scrape.duration_count\", job=~\"$job\"}, exporter.target)",
        "includeAll": true,
        "label": "exporter.target",
        "multi": true,
        "name": "target",
        "options": [],
        "query": { "qryType": 5, "query": "label_values({\"github_exporter.scrape.duration_count\", job=~\"$job\"}, exporter.target)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
{
        "allValue": ".*",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values({job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"!=\"\"}, github.org)",
        "includeAll": true,
        "label": "github.org",
        "multi": true,
        "name": "org",
        "options": [],
        "query": { "qryType": 5, "query": "label_values({job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"!=\"\"}, github.org)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
{
        "allValue": ".*",
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values({job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"!=\"\"}, github.repo)",
        "includeAll": true,
        "label": "github.repo",
        "multi": true,
        "name": "repo",
        "options": [],
        "query": { "qryType": 5, "query": "label_values({job=~\"$job\", \"exporter.target\"=~\"$target\", \"github.org\"=~\"$org\", \"github.repo\"!=\"\"}, github.repo)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "GitHub Activity Exporter",
  "uid": "github-activity-exporter",
  "version": 1
}