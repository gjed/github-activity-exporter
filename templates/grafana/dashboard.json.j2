{#-
  KPI dashboard (dashboards/github-activity.json): the GitHub data only, the
  github.* and renovate.* metrics. The exporter's own metrics are on the
  exporter dashboard (exporter.json.j2). Macros: _macros.j2.
-#}
{%- import "_macros.j2" as m -%}
{%- set st = namespace(x=0, y=0, id=1, used=[]) -%}
{%- set per_hour = " * 3600" -%}
{%- set repo = ["github.org", "github.repo"] -%}
{{ m.head() }}
{{ m.row(st, "Pull requests") }}
{% call m.panel(st, "PRs created, merged and closed per hour", m.brief(ctx, ["github.pr.created", "github.pr.merged", "github.pr.closed"]), "short") %}
{{- m.target("A", m.expr(ctx, st, "github.pr.created", "rate", scale=per_hour), "created") }},
        {{ m.target("B", m.expr(ctx, st, "github.pr.merged", "rate", scale=per_hour), "merged") }},
        {{ m.target("C", m.expr(ctx, st, "github.pr.closed", "rate", scale=per_hour), "closed") -}}
{% endcall %}
{% call m.panel(st, "PRs created, merged and closed per hour by repo", m.brief(ctx, ["github.pr.created", "github.pr.merged", "github.pr.closed"]), "short") %}
{{- m.target("A", m.expr(ctx, st, "github.pr.created", "rate", by=repo, scale=per_hour), "{{github.org}}/{{github.repo}} created") }},
        {{ m.target("B", m.expr(ctx, st, "github.pr.merged", "rate", by=repo, scale=per_hour), "{{github.org}}/{{github.repo}} merged") }},
        {{ m.target("C", m.expr(ctx, st, "github.pr.closed", "rate", by=repo, scale=per_hour), "{{github.org}}/{{github.repo}} closed") -}}
{% endcall %}
{% call m.panel(st, "Open PRs by state", m.brief(ctx, "github.pr.count"), "short") %}
{{- m.target("A", m.expr(ctx, st, "github.pr.count", "sum", by=["github.pr.state"], matchers=[["github.pr.label", "=", ""]]), "{{github.pr.state}}") -}}
{% endcall %}
{% call m.panel(st, "Open PRs by review status", m.brief(ctx, "github.pr.review_status"), "short") %}
{{- m.target("A", m.expr(ctx, st, "github.pr.review_status", "sum", by=["github.pr.review_status"]), "{{github.pr.review_status}}") -}}
{% endcall %}
{% call m.panel(st, "Oldest open PR age by repo", m.brief(ctx, "github.pr.age"), "s") %}
{{- m.target("A", m.expr(ctx, st, "github.pr.age", "max", by=repo), "{{github.org}}/{{github.repo}}") -}}
{% endcall %}
{% call m.panel(st, "PR close duration", m.brief(ctx, "github.pr.close.duration"), "s") %}
{{- m.target("A", m.expr(ctx, st, "github.pr.close.duration", "quantile", q="0.5"), "p50") }},
        {{ m.target("B", m.expr(ctx, st, "github.pr.close.duration", "quantile", q="0.9"), "p90") -}}
{% endcall %}
{% call m.panel(st, "PRs automerged per hour", m.brief(ctx, "github.pr.automerged"), "short") %}
{{- m.target("A", m.expr(ctx, st, "github.pr.automerged", "rate", by=repo, scale=per_hour), "{{github.org}}/{{github.repo}}") -}}
{% endcall %}
{{ m.row(st, "Issues") }}
{% call m.panel(st, "Issues by state", m.brief(ctx, "github.issue.count"), "short") %}
{{- m.target("A", m.expr(ctx, st, "github.issue.count", "sum", by=["github.issue.state"], matchers=[["github.issue.state", "!=", ""]]), "{{github.issue.state}}") -}}
{% endcall %}
{% call m.panel(st, "Oldest open issue age by repo", m.brief(ctx, "github.issue.age"), "s") %}
{{- m.target("A", m.expr(ctx, st, "github.issue.age", "max", by=repo), "{{github.org}}/{{github.repo}}") -}}
{% endcall %}
{{ m.row(st, "Dependency Dashboard") }}
{% call m.panel(st, "Renovate queue by section", m.brief(ctx, "renovate.dashboard.queue"), "short") %}
{{- m.target("A", m.expr(ctx, st, "renovate.dashboard.queue", "sum", by=["github.org", "github.repo", "renovate.dashboard.section"]), "{{github.org}}/{{github.repo}} {{renovate.dashboard.section}}") -}}
{% endcall %}
{% call m.panel(st, "Dependency Dashboard parse errors", m.brief(ctx, "renovate.dashboard.parse_error"), "short") %}
{{- m.target("A", m.expr(ctx, st, "renovate.dashboard.parse_error", "max", by=repo), "{{github.org}}/{{github.repo}}") -}}
{% endcall %}
{#- Scope: the KPI dashboard queries the GitHub data only. -#}
{%- for name in st.used -%}
{%- if not (name is startingwith("github.") or name is startingwith("renovate.")) %}{{ dashboard_metric_out_of_scope(name) }}{% endif -%}
{%- endfor %}
{% call m.tail("GitHub Activity", "github-activity-exporter", ["github", "renovate", "generated"]) -%}
{#- job and exporter.target resolve from every series this dashboard queries,
    never from a self-metric: a target is listed as soon as any panel has data
    for it, whichever collectors it enables. Prometheus derives job from
    service.namespace/service.name; the exporter's service.name is
    github-activity-exporter. -#}
{%- set series = '__name__=~"' ~ m.series_regex(ctx, st.used) ~ '"' -%}
{{ m.variable("job", "Job", "{" ~ series ~ ', job=~"(.+/)?github-activity-exporter"}', "job") }},
{{ m.variable("target", "exporter.target", "{" ~ series ~ ', job=~"$job"}', "exporter.target") }},
{{ m.variable("org", "github.org", '{job=~"$job", "exporter.target"=~"$target", "github.org"!=""}', "github.org") }},
{{ m.variable("repo", "github.repo", '{job=~"$job", "exporter.target"=~"$target", "github.org"=~"$org", "github.repo"!=""}', "github.repo") -}}
{% endcall %}
